FROM golangci/golangci-lint:v2.15.0-alpine@sha256:2ba875b990f1d8501ad4ec19be1ea0701e316ec3a4b764f7b129f62f01318bbf AS lint
FROM golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab

RUN apk add --no-cache build-base=0.5-r4 ffmpeg=8.1.3-r0 font-dejavu=2.37-r6
COPY --from=lint /usr/bin/golangci-lint /usr/local/bin/golangci-lint
RUN GOBIN=/usr/local/bin go install golang.org/x/vuln/cmd/govulncheck@v1.6.0

ENV GOTOOLCHAIN=local
WORKDIR /work
USER 65532:65532
